<Window x:Class="GafiFish.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GafiFish" Height="920" Width="1480"
        MinHeight="780" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="#0A1118" Foreground="#EAF0F5"
        FontFamily="Segoe UI"
        SourceInitialized="Window_SourceInitialized"
        Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#294153" />
            <Setter Property="Foreground" Value="#F4F8FB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1.015" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1.015" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="#EAF0F5" />
            <Setter Property="Background" Value="#192733" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxFrame" Background="{TemplateBinding Background}"
                                BorderBrush="#344957" BorderThickness="1" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxFrame" Property="BorderBrush" Value="#67D5B5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxFrame" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#DCE7EE" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SwitchTrack" Width="38" Height="22"
                                    CornerRadius="11" Background="#293A47"
                                    BorderBrush="#3C5362" BorderThickness="1"
                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Ellipse x:Name="SwitchThumb" Width="14" Height="14"
                                         Fill="#A6B8C5" HorizontalAlignment="Left"
                                         Margin="3,0,0,0" />
                            </Border>
                            <ContentPresenter Grid.Column="1" ContentSource="Content"
                                              VerticalAlignment="Center" RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontSize="13" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#226454" />
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#3E9A80" />
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="#F2FFFA" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="19,0,0,0" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#72CDB3" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#83E0C6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#A9B8C5" />
            <Setter Property="Background" Value="#17232E" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Margin" Value="0,0,8,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#214D45" />
                                <Setter Property="Foreground" Value="#F2FFFA" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="GafiFish" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="FISCH CONTROL CENTRE  ·  LOCAL DESKTOP ASSISTANT"
                           Foreground="#8EA4B5" FontSize="10" FontWeight="SemiBold" Margin="1,4,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#172B2B" BorderBrush="#2D5B52"
                    BorderThickness="1" CornerRadius="12" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#67D5B5" Margin="0,0,8,0" />
                    <TextBlock Text="EXTERNAL · LOCAL PROCESSING" Foreground="#A7E7D4"
                               FontSize="10" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </DockPanel>

<TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,4,0,0" TabStripPlacement="Top" SelectionChanged="MainTabs_SelectionChanged">
                <TabItem Header="Dashboard">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="1120" HorizontalAlignment="Center" Margin="0,2,4,12">
                <Grid Margin="0,2,0,16" Height="560">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.45*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="1*" />
    </Grid.ColumnDefinitions>
    <Border Background="#151F29" BorderBrush="#263847"
                    BorderThickness="1" CornerRadius="20" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Live capture" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusText" Text="Waiting for Roblox" Foreground="#9BAAB8" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ResolutionText" DockPanel.Dock="Right" Text="No frame yet"
                                   Foreground="#9BAAB8" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Grid.Row="1" Background="#080D12" CornerRadius="14"
                            BorderBrush="#2C3C48" BorderThickness="1" Padding="5">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" IsHitTestVisible="False" />
                            <TextBlock x:Name="PreviewPlaceholder" IsHitTestVisible="False"
                                       Text="Press F6 while Roblox is focused to capture a frame.&#10;Press F7 to toggle continuous observation."
                                       Foreground="#718395" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="15" TextWrapping="Wrap" />
                            <Canvas x:Name="PreviewOverlay" Background="Transparent"
                                    MouseLeftButtonDown="PreviewOverlay_MouseLeftButtonDown"
                                    MouseMove="PreviewOverlay_MouseMove"
                                    MouseLeftButtonUp="PreviewOverlay_MouseLeftButtonUp">
                                <Rectangle x:Name="SelectionRectangle" Stroke="#67D5B5"
                                           StrokeThickness="2" Fill="#3367D5B5"
                                           Visibility="Collapsed" IsHitTestVisible="False" />
                            </Canvas>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="VisionStatusText"
                                   Text="Vision engine: awaiting color calibration."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" />
                        <TextBlock x:Name="CastStatusText"
                                   Text="Perfect Cast: awaiting meter calibration."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="ShakeStatusText"
                                   Text="Shake: awaiting prompt calibration."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="SellStatusText"
                                   Text="Sell Anywhere: awaiting button calibration."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="AutomationStatusText"
                                   Text="Reel control: disarmed."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="OcrStatusText"
                                   Text="Local OCR: not initialised."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="TelemetryText"
                                   Text="Telemetry: waiting for the first frame."
                                   Foreground="#67D5B5" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
    <Border Grid.Column="2" Background="#121E28" BorderBrush="#263B49"
            BorderThickness="1" CornerRadius="18" Padding="20">
        <StackPanel>
            <TextBlock Text="Control centre" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="The important switches, live state and quick actions in one place."
                       Foreground="#91A6B5" TextWrapping="Wrap" Margin="0,5,0,16" />
            <CheckBox x:Name="ObservationToggleCheckBox" Content="Live observation"
                      IsChecked="False" Margin="0,0,0,12"
                      Checked="ObservationToggle_Changed" Unchecked="ObservationToggle_Changed" />
            <CheckBox x:Name="FishingMacroToggleCheckBox" Content="Fishing macro · Reel assist"
                      IsChecked="False" Margin="0,0,0,14"
                      Checked="FishingMacroToggle_Changed" Unchecked="FishingMacroToggle_Changed" />
            <Button Content="Capture one frame (F6)" Click="CaptureOnce_Click"
                    Height="38" Background="#263F50" Margin="0,0,0,12" />
            <Separator Margin="0,2,0,14" Background="#2E414F" />
            <TextBlock Text="LIVE STATUS" Foreground="#7F98A9" FontSize="10" FontWeight="Bold" Margin="0,0,0,8" />
            <Border Background="#1B2B37" CornerRadius="11" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="AUTOMATION" Foreground="#7F98A9" FontSize="9" FontWeight="Bold" />
                    <TextBlock Text="{Binding Text, ElementName=AutomationStatusText}"
                               Foreground="#EAF0F5" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="#1B2B37" CornerRadius="11" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="CAPTURE TELEMETRY" Foreground="#7F98A9" FontSize="9" FontWeight="Bold" />
                    <TextBlock Text="{Binding Text, ElementName=TelemetryText}"
                               Foreground="#70DCC1" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="#1B2B37" CornerRadius="11" Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="ACTIVE PROFILE" Foreground="#7F98A9" FontSize="9" FontWeight="Bold" />
                    <TextBlock Text="{Binding Text, ElementName=RodProfileNameTextBox}"
                               Foreground="#EAF0F5" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border Background="#1B2B37" CornerRadius="11" Padding="12">
                <StackPanel>
                    <TextBlock Text="MODULES" Foreground="#7F98A9" FontSize="9" FontWeight="Bold" />
                    <TextBlock x:Name="ModuleQuickInfoText"
                               Text="Reel assist: Off&#10;Auto-cast: Off&#10;Auto-shake: Off&#10;Sell Anywhere: Off&#10;Consumables: Off"
                               Foreground="#DCE6ED" TextWrapping="Wrap" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Grid>
                <Border Background="#151F29" BorderBrush="#283B49" BorderThickness="1"
                        CornerRadius="16" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Current session" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock x:Name="DashboardSessionStatusText"
                                   Text="No active OCR session. Start one in Fishing to monitor live results."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Background="#202E39" CornerRadius="10" Padding="11" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="DURATION" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="DashboardSessionDurationText" Text="—" Foreground="#EAF0F5" FontSize="21" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Background="#202E39" CornerRadius="10" Padding="11" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="SESSION CATCHES" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="DashboardSessionCatchesText" Text="—" Foreground="#67D5B5" FontSize="21" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Background="#202E39" CornerRadius="10" Padding="11">
                                <StackPanel>
                                    <TextBlock Text="CURRENT RATE" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="DashboardSessionRateText" Text="—" Foreground="#EAF0F5" FontSize="21" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Background="#202E39" CornerRadius="10" Padding="11">
                                <StackPanel>
                                    <TextBlock Text="ESTIMATED VALUE" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="DashboardSessionValueText" Text="—" Foreground="#EACB80" FontSize="21" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="CATCH ACTIVITY · LAST 30 MINUTES"
                                   Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" Margin="0,12,0,4" />
                        <Canvas x:Name="DashboardActivityChart" Height="78"
                                SizeChanged="DashboardActivityChart_SizeChanged" />
                        <TextBlock Text="LATEST CATCHES" Foreground="#8EA4B5"
                                   FontSize="10" FontWeight="Bold" Margin="0,12,0,5" />
                        <TextBlock x:Name="DashboardRecentCatchesText"
                                   Text="Recent recognised catches will appear here."
                                   Foreground="#DCE6ED" FontSize="11" TextWrapping="Wrap" />
                        <TextBlock Text="Live rate uses this session's elapsed time. Estimated value includes only catches where OCR recognised a value."
                                   Foreground="#8298A8" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="#151F29" BorderBrush="#283B49" BorderThickness="1"
                        CornerRadius="16" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Lifetime totals" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Local statistics from saved fishing sessions."
                                   Foreground="#9BAAB8" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Background="#202E39" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="SESSIONS" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="DashboardSessionsMetricText" Text="—" Foreground="#EAF0F5" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Background="#202E39" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="TOTAL CATCHES" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="DashboardCatchesMetricText" Text="—" Foreground="#67D5B5" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Background="#202E39" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="LEGENDARY+" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="DashboardLegendaryMetricText" Text="—" Foreground="#EACB80" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Background="#202E39" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="CATCH RATE" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="DashboardCatchRateMetricText" Text="—" Foreground="#EAF0F5" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="Catch rate uses completed sessions only. Unrecognised OCR fields are excluded from the corresponding statistics."
                                   Foreground="#8298A8" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Aquarium">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="1120" HorizontalAlignment="Center" Margin="0,2,4,12">
                            <Border Background="#151F29" BorderBrush="#283B49" BorderThickness="1"
                                    CornerRadius="16" Padding="18" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Aquarium Planner" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Text="Track each hourly food action and reward claim without guessing the cooldown."
                                               Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,5,0,10" />
                                    <TextBlock Text="Track each food action manually or let the optional visual automation click calibrated buttons when their hourly cooldown is ready."
                                               Foreground="#DCE6ED" TextWrapping="Wrap" />
                                    <TextBlock Text="Auto Aquarium requires the panel to stay open. It never guesses button positions: calibrate each enabled action from a live frame first."
                                               Foreground="#EACB80" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#151F29" BorderBrush="#283B49" BorderThickness="1"
                                    CornerRadius="16" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Guppies' Best" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AquariumGuppiesFeedStatusText"
                                               Text="Feed: not tracked yet."
                                               Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,5,0,4" />
                                    <TextBlock x:Name="AquariumGuppiesRestockStatusText"
                                               Text="Restock: not tracked yet."
                                               Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Mark fed" Tag="GuppiesBest.Feed"
                                                Click="AquariumFoodAction_Click" Height="32" Margin="0,0,8,0" />
                                        <Button Content="Mark restocked" Tag="GuppiesBest.Restock"
                                                Click="AquariumFoodAction_Click" Height="32" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#151F29" BorderBrush="#283B49" BorderThickness="1"
                                    CornerRadius="16" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="Fish Chow" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock x:Name="AquariumFishChowFeedStatusText"
                                               Text="Feed: not tracked yet."
                                               Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,5,0,4" />
                                    <TextBlock x:Name="AquariumFishChowRestockStatusText"
                                               Text="Restock: not tracked yet."
                                               Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Mark fed" Tag="FishChow.Feed"
                                                Click="AquariumFoodAction_Click" Height="32" Margin="0,0,8,0" />
                                        <Button Content="Mark restocked" Tag="FishChow.Restock"
                                                Click="AquariumFoodAction_Click" Height="32" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#151F29" BorderBrush="#283B49" BorderThickness="1"
