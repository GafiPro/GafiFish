<Window x:Class="GafiFish.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GafiFish" Height="860" Width="1280"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0C1118" Foreground="#EAF0F5"
        FontFamily="Segoe UI"
        SourceInitialized="Window_SourceInitialized"
        Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="#294153" />
            <Setter Property="Foreground" Value="#F4F8FB" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1.015" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1.015" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                To="1" Duration="0:0:0.14" />
                                            <DoubleAnimation Storyboard.TargetName="ButtonSurface"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                To="1" Duration="0:0:0.14" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.76" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="#EAF0F5" />
            <Setter Property="Background" Value="#192733" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBoxFrame" Background="{TemplateBinding Background}"
                                BorderBrush="#344957" BorderThickness="1" CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBoxFrame" Property="BorderBrush" Value="#67D5B5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBoxFrame" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style TargetType="{x:Type TabItem}">
            <Setter Property="Foreground" Value="#A9B8C5" />
            <Setter Property="Background" Value="#17232E" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="3,0,5,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#214D45" />
                                <Setter Property="Foreground" Value="#F2FFFA" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabSurface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="GafiFish" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="FISCH CONTROL CENTRE  ·  LOCAL DESKTOP ASSISTANT"
                           Foreground="#8EA4B5" FontSize="10" FontWeight="SemiBold" Margin="1,4,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#172B2B" BorderBrush="#2D5B52"
                    BorderThickness="1" CornerRadius="12" Padding="14,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#67D5B5" Margin="0,0,8,0" />
                    <TextBlock Text="EXTERNAL · LOCAL PROCESSING" Foreground="#A7E7D4"
                               FontSize="10" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.08*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#151F29" BorderBrush="#263847"
                    BorderThickness="1" CornerRadius="20" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Live capture" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusText" Text="Waiting for Roblox" Foreground="#9BAAB8" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ResolutionText" DockPanel.Dock="Right" Text="No frame yet"
                                   Foreground="#9BAAB8" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Grid.Row="1" Background="#080D12" CornerRadius="14"
                            BorderBrush="#2C3C48" BorderThickness="1" Padding="5">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" IsHitTestVisible="False" />
                            <TextBlock x:Name="PreviewPlaceholder" IsHitTestVisible="False"
                                       Text="Press F6 while Roblox is focused to capture a frame.&#10;Press F7 to toggle continuous observation."
                                       Foreground="#718395" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="15" TextWrapping="Wrap" />
                            <Canvas x:Name="PreviewOverlay" Background="Transparent"
                                    MouseLeftButtonDown="PreviewOverlay_MouseLeftButtonDown"
                                    MouseMove="PreviewOverlay_MouseMove"
                                    MouseLeftButtonUp="PreviewOverlay_MouseLeftButtonUp">
                                <Rectangle x:Name="SelectionRectangle" Stroke="#67D5B5"
                                           StrokeThickness="2" Fill="#3367D5B5"
                                           Visibility="Collapsed" IsHitTestVisible="False" />
                            </Canvas>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="VisionStatusText"
                                   Text="Vision engine: awaiting color calibration."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" />
                        <TextBlock x:Name="CastStatusText"
                                   Text="Perfect Cast: awaiting meter calibration."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="ShakeStatusText"
                                   Text="Shake: awaiting prompt calibration."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="SellStatusText"
                                   Text="Sell Anywhere: awaiting button calibration."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="AutomationStatusText"
                                   Text="Reel control: disarmed."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="OcrStatusText"
                                   Text="Local OCR: not initialised."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="TelemetryText"
                                   Text="Telemetry: waiting for the first frame."
                                   Foreground="#67D5B5" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl x:Name="MainTabs" Grid.Column="2" Margin="0,2,0,0" SelectionChanged="MainTabs_SelectionChanged">
                <TabItem Header="Dashboard">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,2,4,12">
                <Border Background="#151F29" BorderBrush="#283B49" BorderThickness="1"
                        CornerRadius="16" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Quick actions" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Start, observe and inspect the macro without digging through settings."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,0,0,14" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="9" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Start macro" Click="StartMacro_Click"
                                    Height="44" Background="#285B50" />
                            <Button Grid.Column="2" Content="Stop macro" Click="StopMacro_Click"
                                    Height="44" Background="#653641" />
                        </Grid>
                        <Button Content="Toggle observation" Click="TogglePreview_Click"
                                Height="38" Background="#294153" />
                        <Separator Margin="0,14,0,12" Background="#33414F" />
                        <TextBlock Text="Live overview" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Border Background="#202E39" CornerRadius="10" Padding="11" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="AUTOMATION STATE" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="{Binding Text, ElementName=AutomationStatusText}"
                                           Foreground="#EAF0F5" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#202E39" CornerRadius="10" Padding="11" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="CAPTURE TELEMETRY" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="{Binding Text, ElementName=TelemetryText}"
                                           Foreground="#67D5B5" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#202E39" CornerRadius="10" Padding="11">
                            <StackPanel>
                                <TextBlock Text="ACTIVE PROFILE" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                <TextBlock Text="{Binding Text, ElementName=RodProfileNameTextBox}"
                                           Foreground="#EAF0F5" TextWrapping="Wrap" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Background="#202E39" CornerRadius="10" Padding="11" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="MODULE QUICK INFO" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                <TextBlock x:Name="ModuleQuickInfoText"
                                           Text="Reel assist: Off&#10;Auto-cast: Off&#10;Auto-shake: Off&#10;Sell Anywhere: Off&#10;Consumables: Off"
                                           Foreground="#DCE6ED" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Background="#151F29" BorderBrush="#283B49" BorderThickness="1"
                        CornerRadius="16" Padding="18" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Lifetime totals" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Text="Local statistics from saved fishing sessions."
                                   Foreground="#9BAAB8" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Row="0" Grid.Column="0" Background="#202E39" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="SESSIONS" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="DashboardSessionsMetricText" Text="—" Foreground="#EAF0F5" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="0" Grid.Column="2" Background="#202E39" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="TOTAL CATCHES" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="DashboardCatchesMetricText" Text="—" Foreground="#67D5B5" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="0" Background="#202E39" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="LEGENDARY+" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="DashboardLegendaryMetricText" Text="—" Foreground="#EACB80" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="2" Background="#202E39" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="CATCH RATE" Foreground="#8EA4B5" FontSize="10" FontWeight="Bold" />
                                    <TextBlock x:Name="DashboardCatchRateMetricText" Text="—" Foreground="#EAF0F5" FontSize="24" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Text="Catch rate uses completed sessions only. Unrecognised OCR fields are excluded from the corresponding statistics."
                                   Foreground="#8298A8" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Fishing">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,2,4,12">
<Border Background="#151F29" BorderBrush="#283B49" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Capture controls" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />                        <TextBlock Text="Rod calibration profile" Foreground="#9BAAB8" Margin="0,0,0,5" />
                        <TextBox x:Name="RodProfileNameTextBox" Text="Default" Height="32"
                                 Padding="8,5" Margin="0,0,0,7"
                                 Background="#263543" Foreground="#EAF0F5" />
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Load profile" Click="LoadRodProfile_Click"
                                    Height="32" Background="#294153" Foreground="White" BorderThickness="0" />
                            <Button Grid.Column="2" Content="Save profile" Click="SaveRodProfile_Click"
                                    Height="32" Background="#294153" Foreground="White" BorderThickness="0" />
                        </Grid>
                        <TextBlock Text="Create a named visual-calibration profile for each rod. Select the profile manually before fishing."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <TextBlock Text="Capture performance" Foreground="#9BAAB8" Margin="0,0,0,5" />
                        <ComboBox x:Name="CapturePerformanceModeComboBox" SelectedIndex="1" Height="34"
                                  Background="#20313E" Foreground="#EAF0F5" Margin="0,0,0,5">
                            <ComboBoxItem Content="Economy · lower CPU use" />
                            <ComboBoxItem Content="Balanced · recommended" />
                            <ComboBoxItem Content="Responsive · faster tracking" />
                        </ComboBox>
                        <TextBlock x:Name="PerformanceModeStatusText"
                                   Text="Balanced capture cadence · adaptive frame pacing."
                                   Foreground="#8FA8B8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <Button Content="Capture frame" Click="CaptureOnce_Click"
                                Height="38" Margin="0,0,0,8"
                                Background="#294153" Foreground="White" BorderThickness="0" />
                        <Button x:Name="PreviewButton" Content="Start observation" Click="TogglePreview_Click"
                                Height="38" Background="#285B50" Foreground="White" BorderThickness="0" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="StartMacroButton" Grid.Column="0"
                                    Content="Start macro (F8)" Click="StartMacro_Click"
                                    Height="38" Background="#285B50" Foreground="White" BorderThickness="0" />
                            <Button x:Name="StopMacroButton" Grid.Column="2"
                                    Content="Stop macro (F9)" Click="StopMacro_Click"
                                    Height="38" Background="#6B343D" Foreground="White" BorderThickness="0"
                                    IsEnabled="False" />
                        </Grid>
                        <TextBlock Text="F6 captures one frame. F7 starts or stops live observation. Use the keys while Roblox is the foreground window; Alt+Tab back here to inspect the latest frame."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <Separator Margin="0,8,0,8" Background="#33414F" />
                        <TextBlock Text="Reel assist: F8 arms the calibrated hold/release controller; F9 immediately stops it and releases input. It requires the Roblox window in the foreground."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,10,0,8" />
                        <CheckBox x:Name="InvertReelDirectionCheckBox"
                                  Content="Invert hold/release mapping (test with a safe catch)"
                                  Foreground="#EAF0F5" IsChecked="False" Margin="0,0,0,8" />
                        <CheckBox x:Name="AutoCastCheckBox"
                                  Content="Auto-cast + auto-recast (Perfect Cast; 2 missed-bite retries by default)"
                                  Foreground="#EAF0F5" IsChecked="False" Margin="0,0,0,6"
                                  Checked="AutoCastCheckBox_Changed"
                                  Unchecked="AutoCastCheckBox_Changed" />
                        <CheckBox x:Name="KeepFishingUntilCatchCheckBox"
                                  Content="Keep fishing until the first fish is caught (unlimited retries)"
                                  Foreground="#EAF0F5" IsChecked="False" IsEnabled="False"
                                  Margin="0,0,0,6" />
                        <TextBlock Text="Requires Auto-cast, an active local OCR session and a calibrated catch-notification region. F9, loss of Roblox focus and stopping F7 remain emergency stops."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <CheckBox x:Name="TargetFishCheckBox"
                                  Content="Fish until this exact target is caught"
                                  Foreground="#EAF0F5" IsChecked="False" IsEnabled="False"
                                  Margin="0,0,0,6"
                                  Checked="TargetFishCheckBox_Changed"
                                  Unchecked="TargetFishCheckBox_Changed" />
                        <TextBox x:Name="TargetFishTextBox"
                                 Text="Wrath Scylla" IsEnabled="False"
                                 Height="34" Padding="8,5" Margin="0,0,0,7"
                                 Background="#263543" Foreground="#EAF0F5"
                                 ToolTip="Example: Wrath Scylla" />
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Stop after this many target catches"
                                       Foreground="#9BAAB8" VerticalAlignment="Center" />
                            <TextBox x:Name="TargetFishCatchGoalTextBox" Grid.Column="1"
                                     Text="1" IsEnabled="False" Height="32" Padding="7,4"
                                     Background="#263543" Foreground="#EAF0F5"
                                     HorizontalContentAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="TargetFishProgressText" Text="Target progress · 0 / 1"
                                   Foreground="#67D5B5" FontSize="11" Margin="0,0,0,8" />
                        <TextBlock Text="Target matching checks the catch notification text (case-insensitive, punctuation-insensitive). It does not stop for unrelated catches."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <CheckBox x:Name="AutoShakeCheckBox"
                                  Content="Auto-shake (stable prompts; detects end of prompt sequence)"
                                  Foreground="#EAF0F5" IsChecked="False" Margin="0,0,0,8"
                                  Checked="ModuleOption_Changed" Unchecked="ModuleOption_Changed" />
                        <CheckBox x:Name="EquipRodCheckBox"
                                  Content="Equip my rod from the hotbar when F8 starts"
                                  Foreground="#EAF0F5" IsChecked="False"
                                  Checked="EquipRodCheckBox_Changed"
                                  Unchecked="EquipRodCheckBox_Changed"
                                  Margin="0,0,0,6" />
                        <ComboBox x:Name="RodSlotComboBox" SelectedIndex="0" IsEnabled="False"
                                  Height="30" Margin="0,0,0,8"
                                  Background="#263543" Foreground="#EAF0F5">
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="5" />
                            <ComboBoxItem Content="6" />
                            <ComboBoxItem Content="7" />
                            <ComboBoxItem Content="8" />
                            <ComboBoxItem Content="9" />
                            <ComboBoxItem Content="0" />
                        </ComboBox>
                        <CheckBox x:Name="SellAnywhereCheckBox"
                                  Content="Enable Sell Anywhere every 10 minutes (non-favourites are sold)"
                                  Foreground="#EAF0F5" IsChecked="False"
                                  Checked="ModuleOption_Changed" Unchecked="ModuleOption_Changed" />
                        <TextBlock Text="Without hotbar selection, keep the fishing rod equipped before F8. If enabled, choose the slot containing your rod. The slot is pressed once using normal keyboard input."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="Sell Anywhere also requires an active OCR session and calibrated button and inventory-list regions."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,8,0,0" />                        <Separator Margin="0,12,0,10" Background="#33414F" />
                        <TextBlock Text="Timed consumables (optional)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <CheckBox x:Name="AutoTotemCheckBox" Content="Use a totem periodically"
                                  Foreground="#EAF0F5" IsChecked="False" Margin="0,0,0,6"
                                  Checked="TimedItemCheckBox_Changed" Unchecked="TimedItemCheckBox_Changed" />
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="78" /><ColumnDefinition Width="48" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="TotemSlotComboBox" SelectedIndex="2" Height="30"
                                      Background="#263543" Foreground="#EAF0F5" IsEnabled="False">
                                <ComboBoxItem Content="1" /><ComboBoxItem Content="2" /><ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4" /><ComboBoxItem Content="5" /><ComboBoxItem Content="6" />
