                            <Button x:Name="ExportCsvButton" Content="Export session CSV" Click="ExportCsv_Click"
                                    Width="150" Height="34" Margin="0,0,8,0"
                                    Background="#294153" Foreground="White" BorderThickness="0"
                                    IsEnabled="False" />
                            <Button x:Name="ExportJsonButton" Content="Export session JSON" Click="ExportJson_Click"
                                    Width="150" Height="34"
                                    Background="#294153" Foreground="White" BorderThickness="0"
                                    IsEnabled="False" />
                        </StackPanel>
                        <Separator Margin="0,10,0,8" Background="#33414F" />
                        <TextBlock Text="Full local catch archive" Foreground="#9BAAB8" Margin="0,0,0,7" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Export all CSV" Click="ExportAllHistoryCsv_Click"
                                    Width="150" Height="32" Margin="0,0,8,0"
                                    Background="#203847" Foreground="#EAF0F5" />
                            <Button Content="Export all JSON" Click="ExportAllHistoryJson_Click"
                                    Width="150" Height="32" Background="#203847" Foreground="#EAF0F5" />
                        </StackPanel>
                        <TextBlock x:Name="SessionStatusText" Text="No session running."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock x:Name="SessionSummaryText" Text=""
                                   Foreground="#EAF0F5" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <Button Content="Copy session summary" Click="CopySessionSummary_Click"
                                Height="32" Margin="0,8,0,0" Background="#294153" Foreground="White" BorderThickness="0" />
                        <Separator Margin="0,14,0,10" Background="#33414F" />
                        <TextBlock Text="Recent sessions (latest 20)" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Button Content="Refresh session history" Click="RefreshSessionHistory_Click"
                                Height="32" Margin="0,0,0,8" Background="#294153" Foreground="White" BorderThickness="0" />
                        <ListBox x:Name="SessionHistoryList" Height="148" SelectionChanged="SessionHistoryList_SelectionChanged"
                                 Background="#263543" Foreground="#EAF0F5" BorderBrush="#405363"
