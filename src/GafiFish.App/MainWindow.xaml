                </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Sessions">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,2,4,12">
<Border Background="#151F29" BorderBrush="#283B49" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Session history" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Button x:Name="StartSessionButton" Content="Start session + local OCR" Click="StartSession_Click"
                                Height="36" Margin="0,0,0,7"
