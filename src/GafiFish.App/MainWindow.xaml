                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,3">
                                        <TextBlock Text="{Binding StartedAt, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                                   Foreground="#EAF0F5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TotalCatches, StringFormat={}{0} catches}"
                                                   Foreground="#9BAAB8" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Border Background="#202C37" CornerRadius="8" Padding="10" Margin="0,8,0,0">
                            <TextBlock x:Name="SelectedSessionDetailsText"
                                       Text="Select a saved session to inspect its catches."
                                       Foreground="#EAF0F5" TextWrapping="Wrap" />
                        </Border>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Export diagnostics" Click="ExportDiagnostics_Click"
                                    Height="34" Background="#294153" Foreground="White" BorderThickness="0" />
                            <Button Grid.Column="2" Content="Export support bundle" Click="ExportSupportBundle_Click"
                                    Height="34" Background="#285B50" Foreground="White" BorderThickness="0"
                                    ToolTip="ZIP with diagnostics, recent activity log and a readme. No screenshots or database." />
                        </Grid>
                        <Separator Margin="0,14,0,10" Background="#33414F" />
                        <TextBlock Text="Catch alerts" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock Text="Priority species (comma-separated)" Foreground="#9BAAB8" Margin="0,0,0,5" />
                        <TextBox x:Name="WatchSpeciesTextBox" Text="" Height="32" Padding="8,5"
                                 Background="#263543" Foreground="#EAF0F5"
                                 ToolTip="Examples: Scylla, Megalodon, Bluefin Tuna" />
                        <CheckBox x:Name="AlertLegendaryCheckBox"
                                  Content="Alert for Legendary, Mythical, Exotic, Secret or Apex"
                                  IsChecked="True" Foreground="#EAF0F5" Margin="0,8,0,4" />
                        <CheckBox x:Name="AlertMutationCheckBox"
                                  Content="Alert for any recognised mutation"
                                  IsChecked="False" Foreground="#EAF0F5" Margin="0,2,0,8" />
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Minimum recognised weight (kg)" Foreground="#DCE6ED" VerticalAlignment="Center" />
                            <TextBox x:Name="MinimumAlertWeightTextBox" Grid.Column="1" Height="30" Padding="8,4"
                                     Background="#263543" Foreground="#EAF0F5" ToolTip="Leave blank to disable weight alerts." />
                        </Grid>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Minimum estimated value" Foreground="#DCE6ED" VerticalAlignment="Center" />
                            <TextBox x:Name="MinimumAlertValueTextBox" Grid.Column="1" Height="30" Padding="8,4"
                                     Background="#263543" Foreground="#EAF0F5" ToolTip="Leave blank to disable value alerts." />
                        </Grid>
                        <TextBlock Text="Numeric alerts only trigger when OCR recognised the relevant value."
                                   Foreground="#8298A8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5" />
                        <TextBlock x:Name="CatchAlertStatusText"
                                   Text="Alerts ready · Legendary+ enabled."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,5,0,0" />
                        <Button Content="Save alert preferences" Click="SaveCatchAlertSettings_Click"
                                Height="32" Margin="0,8,0,0" Background="#294153" Foreground="White" BorderThickness="0" />
                        <TextBlock x:Name="CatchAlertSettingsStatusText"
                                   Text="Alert preferences are loaded when GafiFish starts."
                                   Foreground="#8298A8" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0" />
                        <Separator Margin="0,14,0,10" Background="#33414F" />
                        <TextBlock Text="Lifetime statistics" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <Button Content="Refresh lifetime statistics" Click="RefreshLifetimeStats_Click"
                                Height="32" Background="#294153" Foreground="White" BorderThickness="0" />
                        <TextBlock x:Name="LifetimeStatsText"
                                   Text="Loading saved fishing statistics…"
                                   Foreground="#EAF0F5" TextWrapping="Wrap" Margin="0,9,0,0" />
                        <TextBlock Text="OCR runs locally on the selected notification region. The first session downloads the English language model once."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Catchbook">
                    <Grid Margin="0,2,4,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#151F29" BorderBrush="#283B49" BorderThickness="1"
                                CornerRadius="16" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Catchbook" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="Browse every locally recognised catch across all saved sessions. Nothing is uploaded."
                                           Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,5,0,12" />
                                <TextBlock x:Name="CatchArchiveSummaryText"
                                           Text="Loading catch archive…"
                                           Foreground="#67D5B5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBlock Text="Search species, mutation, rarity, weight, value or session ID."
                                           Foreground="#8298A8" FontSize="11" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Background="#151F29" BorderBrush="#283B49" BorderThickness="1"
                                CornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="CatchHistorySearchTextBox" Grid.Column="0" Height="34" Padding="9,6"
                                             Background="#20313E" Foreground="#EAF0F5" BorderBrush="#405363"
                                             ToolTip="Search the complete catch archive"
                                             TextChanged="CatchHistorySearch_TextChanged" />
                                    <ComboBox x:Name="CatchRarityFilterComboBox" Grid.Column="2" Height="34"
                                              Background="#20313E" Foreground="#EAF0F5"
                                              SelectionChanged="CatchHistoryRarity_SelectionChanged" />
                                    <Button Grid.Column="4" Content="Clear filters" Click="ClearCatchHistoryFilters_Click"
                                            Height="34" Padding="12,0" Background="#294153" Foreground="White" BorderThickness="0" />
                                </Grid>
                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox x:Name="IdentifiedCatchesOnlyCheckBox" Content="Identified only"
                                              Foreground="#EAF0F5" Margin="0,0,18,0"
                                              Checked="CatchHistoryFilter_Changed" Unchecked="CatchHistoryFilter_Changed" />
                                    <CheckBox x:Name="MutatedCatchesOnlyCheckBox" Content="Has mutation"
                                              Foreground="#EAF0F5"
                                              Checked="CatchHistoryFilter_Changed" Unchecked="CatchHistoryFilter_Changed" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataGrid x:Name="CatchHistoryGrid" Grid.Row="2"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeRows="False" CanUserSortColumns="True"
                                  SelectionMode="Single" SelectionUnit="FullRow"
                                  SelectionChanged="CatchHistoryGrid_SelectionChanged"
                                  EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.CanContentScroll="True"
                                  Background="#101A23" Foreground="#EAF0F5"
                                  BorderBrush="#283B49" RowBackground="#17232D"
                                  AlternatingRowBackground="#1D2B37"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#283B49"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Caught at" Binding="{Binding CaughtAtDisplay}" SortMemberPath="CaughtAt" Width="155" />
                                <DataGridTextColumn Header="Species" Binding="{Binding SpeciesDisplay}" SortMemberPath="Species" Width="*" />
                                <DataGridTextColumn Header="Rarity" Binding="{Binding RarityDisplay}" SortMemberPath="Rarity" Width="105" />
                                <DataGridTextColumn Header="Mutation" Binding="{Binding MutationDisplay}" SortMemberPath="Mutation" Width="125" />
                                <DataGridTextColumn Header="Weight" Binding="{Binding WeightDisplay}" SortMemberPath="WeightKg" Width="85" />
                                <DataGridTextColumn Header="Est. value" Binding="{Binding EstimatedValueDisplay}" SortMemberPath="EstimatedValue" Width="95" />
                                <DataGridTextColumn Header="OCR" Binding="{Binding ConfidenceDisplay}" SortMemberPath="RecognitionConfidence" Width="65" />
                                <DataGridTextColumn Header="Session" Binding="{Binding SessionStartedAtDisplay}" SortMemberPath="SessionStartedAt" Width="145" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Grid Grid.Row="3" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CatchArchiveStatusText" Grid.Column="0"
                                       Text="The archive is stored locally in the GafiFish SQLite database."
                                       Foreground="#9BAAB8" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Button x:Name="CopySelectedCatchButton" Grid.Column="1" Content="Copy selected"
                                    Click="CopySelectedCatch_Click" Height="34" Padding="12,0"
                                    Background="#294153" Foreground="White" BorderThickness="0" IsEnabled="False" />
                            <Button x:Name="ExportFilteredCatchHistoryButton" Grid.Column="3" Content="Export filtered CSV"
                                    Click="ExportFilteredCatchHistoryCsv_Click" Height="34" Padding="12,0"
                                    Background="#285B50" Foreground="White" BorderThickness="0" IsEnabled="False" />
                            <Button x:Name="ExportFilteredCatchHistoryJsonButton" Grid.Column="5" Content="Export JSON"
                                    Click="ExportFilteredCatchHistoryJson_Click" Height="34" Padding="12,0"
                                    Background="#285B50" Foreground="White" BorderThickness="0" IsEnabled="False" />
                            <Button Grid.Column="7" Content="Refresh" Click="RefreshCatchArchive_Click"
                                    Height="34" Padding="12,0" Background="#203847" Foreground="White" BorderThickness="0" />
                        </Grid>
                    </Grid>
                </TabItem>
                <TabItem Header="Settings">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,2,4,12">
                            <Border Background="#151F29" BorderBrush="#283B49" BorderThickness="1"
                                    CornerRadius="16" Padding="18" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Data backup" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5" />
                                    <TextBlock Text="Create a portable ZIP containing your fishing database, calibration profiles, hotkeys, alert preferences, logs and local OCR model. SQLite is captured using its online backup mechanism."
                                               Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,0,0,12" />
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="CreateDataBackupButton" Grid.Column="0" Content="Create backup ZIP"
                                                Click="CreateDataBackup_Click" Height="38" Background="#285B50" />
                                        <Button x:Name="VerifyDataBackupButton" Grid.Column="2" Content="Verify backup ZIP"
                                                Click="VerifyDataBackup_Click" Height="38" Background="#294153" />
                                    </Grid>
                                    <TextBlock x:Name="DataBackupStatusText"
                                               Text="Backups are local. Temporary files and older backup ZIPs are excluded."
                                               Foreground="#8298A8" FontSize="11" TextWrapping="Wrap" />
                                    <Border Background="#101A23" BorderBrush="#283B49" BorderThickness="1"
                                            CornerRadius="9" Padding="10" Margin="0,10,0,0">
                                        <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="DataBackupContentsText"
                                                       Text="Verify a backup to preview the files it contains. No data is extracted or restored."
                                                       Foreground="#C8D5DE" FontSize="11" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

<Border Background="#151F29" BorderBrush="#283B49" BorderThickness="1"
                        CornerRadius="16" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Global hotkeys" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5" />
                        <TextBlock Text="Choose unique function keys. The assignments are saved locally and work even while Roblox is focused."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Capture one frame" Foreground="#DCE6ED" VerticalAlignment="Center" />
                            <ComboBox x:Name="CaptureHotkeyComboBox" Grid.Column="1" Height="32" Background="#20313E" Foreground="#EAF0F5" />
                        </Grid>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Start / stop observation" Foreground="#DCE6ED" VerticalAlignment="Center" />
                            <ComboBox x:Name="ObserveHotkeyComboBox" Grid.Column="1" Height="32" Background="#20313E" Foreground="#EAF0F5" />
                        </Grid>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Start fishing macro" Foreground="#DCE6ED" VerticalAlignment="Center" />
                            <ComboBox x:Name="StartHotkeyComboBox" Grid.Column="1" Height="32" Background="#20313E" Foreground="#EAF0F5" />
                        </Grid>
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Emergency stop" Foreground="#DCE6ED" VerticalAlignment="Center" />
                            <ComboBox x:Name="StopHotkeyComboBox" Grid.Column="1" Height="32" Background="#20313E" Foreground="#EAF0F5" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Show / hide GafiFish" Foreground="#DCE6ED" VerticalAlignment="Center" />
                            <ComboBox x:Name="ToggleUiHotkeyComboBox" Grid.Column="1" Height="32" Background="#20313E" Foreground="#EAF0F5" />
                        </Grid>
                        <CheckBox x:Name="HideUiWhileRunningCheckBox"
                                  Content="Hide the GafiFish window while the fishing macro is running"
                                  IsChecked="True" Foreground="#EAF0F5" Margin="0,5,0,10" />
                        <Button Content="Apply and save hotkeys" Click="ApplyHotkeys_Click" Height="36" Background="#285B50" />
                        <TextBlock x:Name="GlobalHotkeyStatusText" Text="Hotkeys will be loaded when the app starts."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,9,0,0" />
                        <TextBlock Text="F2–F12 are available. Each action must use a different key. The visibility key remains active when the window is hidden."
                                   Foreground="#8298A8" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                <Border Background="#151F29" BorderBrush="#283B49" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="MVP features" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="• Calibrated fish/bar tracking" Margin="0,3" />
                        <TextBlock Text="• Perfect Cast timing diagnostics" Margin="0,3" />
                        <TextBlock Text="• Shake prompt candidate detection" Margin="0,3" />
                        <TextBlock Text="• F8/F9 guarded Reel assist" Margin="0,3" />
                        <TextBlock Text="• Sell Anywhere every 10 minutes (OCR + calibration required)" Margin="0,3" />
                        <TextBlock Text="• Local OCR session history — Top 25" Margin="0,3" />
                    </StackPanel>
                </Border>
<Border Background="#151F29" BorderBrush="#283B49" BorderThickness="1" CornerRadius="16" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Safety" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Reel assist is opt-in and only sends a guarded left-mouse hold/release while both calibrated markers are visible."
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Capture only works while the visible Roblox window is in the foreground. No memory reading, code injection, or remote image upload."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Logs">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,2,4,12">
                            <Border Background="#151F29" BorderBrush="#283B49" BorderThickness="1" CornerRadius="16" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Activity &amp; engine log" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="A persistent local timeline. Search messages or filter by level; the active log rotates automatically so it cannot grow forever."
                                               Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,5,0,12" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="140" /><ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ActivityLogSearchTextBox" Grid.Column="0" Height="34" Padding="9,6"
                                                 Background="#20313E" Foreground="#EAF0F5" BorderBrush="#405363"
                                                 ToolTip="Search in the visible recent log entries"
                                                 TextChanged="ActivityLogSearch_TextChanged" />
                                        <ComboBox x:Name="ActivityLogLevelComboBox" Grid.Column="2" Height="34"
                                                  Background="#20313E" Foreground="#EAF0F5"
                                                  SelectionChanged="ActivityLogLevel_SelectionChanged" />
                                        <CheckBox x:Name="ActivityLogFollowNewestCheckBox" Grid.Column="4"
                                                  Content="Follow newest" IsChecked="True" VerticalAlignment="Center"
                                                  Foreground="#A9B8C5" ToolTip="Automatically scroll to new events. Turn off to inspect older entries." />
                                    </Grid>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="Copy visible" Click="CopyActivityLog_Click" Height="34" Background="#294153" />
                                        <Button Grid.Column="2" Content="Export TXT" Click="ExportActivityLog_Click" Height="34" Background="#294153" />
                                        <Button Grid.Column="4" Content="Clear history" Click="ClearActivityLog_Click" Height="34" Background="#4A3037" />
                                        <Button Grid.Column="6" Content="Open data folder" Click="OpenDataFolder_Click" Height="34" Background="#203847" />
                                    </Grid>
                                    <ListBox x:Name="ActivityLogList" Height="470" Background="#0E1720" Foreground="#DCE6ED"
                                             BorderBrush="#2D414F" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="3,5" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="ActivityLogStatusText"
                                               Text="The latest 500 events are shown here. A rolling log and one archive are stored under %LOCALAPPDATA%\\GafiFish\\logs."
                                               Foreground="#8298A8" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Background="#151F29" BorderBrush="#283B49" BorderThickness="1"
                CornerRadius="14" Padding="14" Margin="0,14,0,0">
            <DockPanel>
                <TextBlock x:Name="BuildStatusText" Text=".NET 10 · OpenCV · local screen capture"
                           Foreground="#9BAAB8" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Close" Width="110" Height="34"
                        Background="#2D3D4B" Foreground="White" BorderThickness="0"
                        Click="CloseButton_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
