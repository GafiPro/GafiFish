<Window x:Class="GafiFish.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GafiFish" Height="760" Width="1120"
        MinHeight="640" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#10151D" Foreground="#EAF0F5"
        SourceInitialized="Window_SourceInitialized"
        Closed="Window_Closed">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="GafiFish" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Visual fishing assistant" Foreground="#9BAAB8" Margin="0,4,0,0" />
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#202C37" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                <TextBlock Text="OBSERVE + REEL ASSIST" Foreground="#67D5B5" FontWeight="SemiBold" />
            </Border>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.15*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#19232E" CornerRadius="16" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Live capture" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusText" Text="Waiting for Roblox" Foreground="#9BAAB8" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="ResolutionText" DockPanel.Dock="Right" Text="No frame yet"
                                   Foreground="#9BAAB8" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Grid.Row="1" Background="#0B1016" CornerRadius="10" BorderBrush="#33414F"
                            BorderThickness="1" Padding="4">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform" IsHitTestVisible="False" />
                            <TextBlock x:Name="PreviewPlaceholder" IsHitTestVisible="False"
                                       Text="Press F6 while Roblox is focused to capture a frame.&#10;Press F7 to toggle continuous observation."
                                       Foreground="#718395" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontSize="15" TextWrapping="Wrap" />
                            <Canvas x:Name="PreviewOverlay" Background="Transparent"
                                    MouseLeftButtonDown="PreviewOverlay_MouseLeftButtonDown"
                                    MouseMove="PreviewOverlay_MouseMove"
                                    MouseLeftButtonUp="PreviewOverlay_MouseLeftButtonUp">
                                <Rectangle x:Name="SelectionRectangle" Stroke="#67D5B5"
                                           StrokeThickness="2" Fill="#3367D5B5"
                                           Visibility="Collapsed" IsHitTestVisible="False" />
                            </Canvas>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock x:Name="VisionStatusText"
                                   Text="Vision engine: awaiting color calibration."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" />
                        <TextBlock x:Name="CastStatusText"
                                   Text="Perfect Cast: awaiting meter calibration."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="ShakeStatusText"
                                   Text="Shake: awaiting prompt calibration."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="SellStatusText"
                                   Text="Sell Anywhere: awaiting button calibration."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="AutomationStatusText"
                                   Text="Reel control: disarmed."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="OcrStatusText"
                                   Text="Local OCR: not initialised."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="#19232E" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Capture controls" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Button Content="Capture frame (F6)" Click="CaptureOnce_Click"
                                Height="38" Margin="0,0,0,8"
                                Background="#294153" Foreground="White" BorderThickness="0" />
                        <Button x:Name="PreviewButton" Content="Start observation (F7)" Click="TogglePreview_Click"
                                Height="38" Background="#285B50" Foreground="White" BorderThickness="0" />
                        <TextBlock Text="F6 captures one frame. F7 starts or stops live observation. Use the keys while Roblox is the foreground window; Alt+Tab back here to inspect the latest frame."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <Separator Margin="0,8,0,8" Background="#33414F" />
                        <TextBlock Text="Reel assist: F8 arms the calibrated hold/release controller; F9 immediately stops it and releases input. It requires the Roblox window in the foreground."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,10,0,8" />
                        <CheckBox x:Name="InvertReelDirectionCheckBox"
                                  Content="Invert hold/release mapping (test with a safe catch)"
                                  Foreground="#EAF0F5" IsChecked="False" />
                        <TextBlock Text="Sell Anywhere is scheduled only when its button and item-list regions are calibrated and an OCR session is active."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock x:Name="HotkeyStatusText" Text="Global hotkeys: registering…"
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#19232E" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Visual calibration" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Button Content="Select search region" Click="SelectRegion_Click"
                                Height="34" Margin="0,0,0,7"
                                Background="#294153" Foreground="White" BorderThickness="0" />
                        <Button Content="Sample fish marker" Click="SampleFishMarker_Click"
                                Height="34" Margin="0,0,0,7"
                                Background="#294153" Foreground="White" BorderThickness="0" />
                        <Button Content="Sample control marker" Click="SampleControlMarker_Click"
                                Height="34" Margin="0,0,0,7"
                                Background="#294153" Foreground="White" BorderThickness="0" />
                        <Button Content="Select cast meter region" Click="SelectCastRegion_Click"
                                Height="34" Margin="0,0,0,7"
                                Background="#294153" Foreground="White" BorderThickness="0" />
                        <Button Content="Sample cast indicator" Click="SampleCastIndicator_Click"
                                Height="34" Margin="0,0,0,7"
                                Background="#294153" Foreground="White" BorderThickness="0" />
                        <Button Content="Sample cast target" Click="SampleCastTarget_Click"
                                Height="34" Margin="0,0,0,7"
                                Background="#294153" Foreground="White" BorderThickness="0" />
                        <Button Content="Select Shake region" Click="SelectShakeRegion_Click"
                                Height="34" Margin="0,0,0,7"
                                Background="#294153" Foreground="White" BorderThickness="0" />
                        <Button Content="Sample Shake prompt" Click="SampleShakePrompt_Click"
                                Height="34" Margin="0,0,0,7"
                                Background="#294153" Foreground="White" BorderThickness="0" />
                        <Button Content="Select Sell button region" Click="SelectSellButtonRegion_Click"
                                Height="34" Margin="0,0,0,7"
                                Background="#294153" Foreground="White" BorderThickness="0" />
                        <Button Content="Sample Sell button color" Click="SampleSellButton_Click"
                                Height="34" Margin="0,0,0,7"
                                Background="#294153" Foreground="White" BorderThickness="0" />
                        <Button Content="Select inventory items area" Click="SelectInventoryItemsRegion_Click"
                                Height="34" Margin="0,0,0,7"
                                Background="#294153" Foreground="White" BorderThickness="0" />
                        <Button Content="Select catch notification region" Click="SelectCatchNotificationRegion_Click"
                                Height="34" Margin="0,0,0,7"
                                Background="#294153" Foreground="White" BorderThickness="0" />
                        <Button Content="Reset calibration" Click="ResetCalibration_Click"
                                Height="34" Background="#4A3037" Foreground="White" BorderThickness="0" />
                        <TextBlock x:Name="CalibrationModeText"
                                   Text="Capture a frame first, then choose a calibration action."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#19232E" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Session history" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Button x:Name="StartSessionButton" Content="Start session + local OCR" Click="StartSession_Click"
                                Height="36" Margin="0,0,0,7"
                                Background="#285B50" Foreground="White" BorderThickness="0" />
                        <Button x:Name="EndSessionButton" Content="End session and show Top 25" Click="EndSession_Click"
                                Height="36" Background="#4A3037" Foreground="White" BorderThickness="0"
                                IsEnabled="False" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="ExportCsvButton" Content="Export CSV" Click="ExportCsv_Click"
                                    Width="132" Height="32" Margin="0,0,8,0"
                                    Background="#294153" Foreground="White" BorderThickness="0"
                                    IsEnabled="False" />
                            <Button x:Name="ExportJsonButton" Content="Export JSON" Click="ExportJson_Click"
                                    Width="132" Height="32"
                                    Background="#294153" Foreground="White" BorderThickness="0"
                                    IsEnabled="False" />
                        </StackPanel>
                        <TextBlock x:Name="SessionStatusText" Text="No session running."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock x:Name="SessionSummaryText" Text=""
                                   Foreground="#EAF0F5" TextWrapping="Wrap" Margin="0,10,0,0" />
                        <TextBlock Text="OCR runs locally on the selected notification region. The first session downloads the English language model once."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#19232E" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="MVP features" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="• Calibrated fish/bar tracking" Margin="0,3" />
                        <TextBlock Text="• Perfect Cast timing diagnostics" Margin="0,3" />
                        <TextBlock Text="• Shake prompt candidate detection" Margin="0,3" />
                        <TextBlock Text="• F8/F9 guarded Reel assist" Margin="0,3" />
                        <TextBlock Text="• Sell Anywhere every 10 minutes (OCR + calibration required)" Margin="0,3" />
                        <TextBlock Text="• Local OCR session history — Top 25" Margin="0,3" />
                    </StackPanel>
                </Border>

                <Border Background="#19232E" CornerRadius="16" Padding="18">
                    <StackPanel>
                        <TextBlock Text="Safety" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TextBlock Text="Reel assist is opt-in and only sends a guarded left-mouse hold/release while both calibrated markers are visible."
                                   TextWrapping="Wrap" />
                        <TextBlock Text="Capture only works while the visible Roblox window is in the foreground. No memory reading, code injection, or remote image upload."
                                   Foreground="#9BAAB8" TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Background="#19232E" CornerRadius="14" Padding="14" Margin="0,16,0,0">
            <DockPanel>
                <TextBlock x:Name="BuildStatusText" Text=".NET 10 · OpenCV · local screen capture"
                           Foreground="#9BAAB8" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Right" Content="Close" Width="110" Height="34"
                        Background="#2D3D4B" Foreground="White" BorderThickness="0"
                        Click="CloseButton_Click" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
